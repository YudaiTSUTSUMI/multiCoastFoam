FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      physicsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

frictionMode  average; //minimum,average, default: multiply 

nIterBullet   20;

//implicitEccentric true;

objects
{    
    arm1
    {
        objName         arm1;
        objShape        box;

        position    (0 0 1.2);
        
        // Cuboid dimensions
        Lx              0.1;
        Ly              0.1;
        Lz              0.5;

        // Density of the solid
        rhoSolid        1;
        
        restitution     0.0;
        friction      0.0;

        constraints
        {
        }
        
        writeVTK    true;
    }
    
    arm2
    {
        objName         arm2;
        objShape        box;

        position    (0 -0.1 1.6);
        
        // Cuboid dimensions
        Lx              0.1;
        Ly              0.1;
        Lz              0.5;

        // Density of the solid
        rhoSolid        1;
        
        restitution     0.0;
        friction      0.0;
        
        initialVelocity     (0.1 0 0);
        initialAngularVelocity   (0 0 0);

        constraints
        {
        }
        
        writeVTK    true;
    }
}

joints
{
    hinge
    {
        type hingeSelf;
        obj arm1;
        pivotLocal (0 0 -0.2);
        //pivotWorld (0 0 1);
        axis (0 1 0);
    }
    
    hingePair1
    {
        type          hingePair;
        
        objA          arm1;
        objB          arm2;
        /*pivotA        (0 -0.05 0.2);     
        pivotB        (0 0.05 -0.2);        
        axisA         (0 1 0);       
        axisB         (0 1 0);*/
        
        pivotWorld    (0 -0.05 1.4);
        axisWorld     (0 1 0);  
    }
}


