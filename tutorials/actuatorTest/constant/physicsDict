FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      physicsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

frictionMode  average; //minimum,average, default: multiply 

nIterBullet   20;

//implicitEccentric true;

objects
{
    
    box
    {
        objName         box;
        objShape        box;

        position    (0 0 0.125);
        
        // Cuboid dimensions
        Lx              0.05;
        Ly              0.05;
        Lz              0.15;

        // Density of the solid
        rhoSolid        1000;
        
        initialVelocity     (0 0 0);
        initialAngularVelocity   (0 0 0);

        constraints
        {
        }
        
        actuators
        {
            thruster
            {
                type            thruster;
                positionLocal   (0 0 0.075); // CoM of rigid body
                directionLocal  (1 0 0);
                magnitude       0.375;
            }
            
            /*motor
            {
                type        motor;
                axisLocal   (0 1 0);
                magnitude   0.05;
            }*/
        }
        
        writeVTK    true;
    }
}

joints
{
    hinge
    {
        type hingeSelf;
        obj box;
        pivotLocal (0 0 0);
        //pivotWorld (0 0 0.125);
        axis (0 1 0);
    }
}


MoorDyn
{
}


