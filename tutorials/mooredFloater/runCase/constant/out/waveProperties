FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

inlet
{
    alpha           alpha.water;

    waveModel       StokesV;

    nPaddle         1;

    waveHeight      0.12;

    waveAngle       0.0;

    rampTime        3.2; //3.6 4.0

    activeAbsorption yes;

    wavePeriod      1.6; //1.8 2.0
}

outlet
{
    alpha           alpha.water;

    waveModel       shallowWaterAbsorption;

    nPaddle         1;
}


