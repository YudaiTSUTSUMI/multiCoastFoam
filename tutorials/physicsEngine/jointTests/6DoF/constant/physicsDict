FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      physicsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

frictionMode  average; //minimum,average, default: multiply 

nIterBullet   20;

//implicitEccentric true;

objects
{    
    arm1
    {
        objName         arm1;
        objShape        box;

        position    (0 0 1.2);
        
        // Cuboid dimensions
        Lx              0.1;
        Ly              0.099;
        Lz              0.5;

        // Density of the solid
        rhoSolid        1;

        constraints
        {
        }
        
        writeVTK    true;
    }
    
    arm2
    {
        objName         arm2;
        objShape        box;

        position    (0 -0.1 1.6);
        
        // Cuboid dimensions
        Lx              0.1;
        Ly              0.099;
        Lz              0.5;

        // Density of the solid
        rhoSolid        1;

        constraints
        {
        }
        
        writeVTK    true;
    }
    
    arm3
    {
        objName         arm3;
        objShape        box;

        position    (0 -0.2 2.0);
        
        // Cuboid dimensions
        Lx              0.1;
        Ly              0.099;
        Lz              0.5;

        // Density of the solid
        rhoSolid        1;
        
        initialVelocity     (4 0 0);
        initialAngularVelocity   (0 0 0);

        constraints
        {
        }
        
        writeVTK    true;
    }
}

joints
{
    hinge
    {
        type hingeSelf;
        obj arm1;
        pivotLocal (0 0 0);
        //pivotWorld (0 0 1.2);
        axis (0 1 0);
    }
    
    slider
    {
        type          generic6DoF;
        
        objA          arm1;
        objB          arm2;
        
        frameInA        (0 -0.05 0.2);     
        frameInB        (0 0.05 -0.2);        
        
        //frameWorld      (0 -0.05 1.4);
        
        linearLimitLow      (0 0 -0.4);  
        linearLimitHigh     (0 0 0);  
        angularLimitLow     (0 0 0);  
        angularLimitHigh    (0 0 0);  
    }
    
    hingePair
    {
        type          hingePair;
        
        objA          arm2;
        objB          arm3;
        pivotA        (0 -0.05 0.2);     
        pivotB        (0 0.05 -0.2);        
        axisA         (0 1 0);       
        axisB         (0 1 0);
        
        //pivotWorld    (0.4 -0.15 1.8);
        //axisWorld     (0 1 0);  
    }
}


MoorDyn
