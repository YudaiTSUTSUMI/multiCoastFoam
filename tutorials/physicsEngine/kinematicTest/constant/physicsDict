FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      physicsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

frictionMode  average; //minimum,average, default: multiply 

nIterBullet   20;

//implicitEccentric true;

objects
{    
    box
    {
        objName         box;
        objShape        box;

        position    (0 0 0);
        
        // Cuboid dimensions
        Lx              0.05;
        Ly              0.05;
        Lz              0.15;

        // Density of the solid
        rhoSolid        0;
        
        motionFile      motion.csv; // control kinetic body motion, in "constant"
        
        // These don't work
        //initialVelocity     (0 0 0);
        //initialAngularVelocity   (0 0 0);

        constraints
        {
        }
        
        actuators
        {
        }
        
        writeVTK    true;
    }
    
    box2
    {
        objName         box2;
        objShape        box;

        position    (0 -0.0501 -0.10);
        
        // Cuboid dimensions
        Lx              0.05;
        Ly              0.05;
        Lz              0.15;

        // Density of the solid
        rhoSolid        100;

        constraints
        {
        }
        
        actuators
        {
        }
        
        writeVTK    true;
    }
}

joints
{
    hingePair
    {
        type          hingePair;
        
        objA          box;
        objB          box2;
        
        pivotWorld    (0 -0.05 -0.05);
        axisWorld     (0 1 0);  
    }
}


MoorDyn
{
}


