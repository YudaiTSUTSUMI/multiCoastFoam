FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     overInterDyMFoamPlus;

startFrom       latestTime;

startTime       0.0;

stopAt          endTime;

endTime         20;

deltaT          0.002;

writeControl    adjustable;

writeInterval   0.03333333333333333333;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.8;

maxAlphaCo      0.8;

maxDeltaT       0.01;

functions
{
}


