FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField     uniform 0;

boundaryField
{
    oversetPatch
    {
        type            overset;
        value           uniform 0;
    }    
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    outlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    walls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    top
    {
        type            totalPressure;
        p0              uniform 0;
    }
    floaterOverset
    {
        type            overset;
        value           uniform 0;
    }
    floaterOut
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}


