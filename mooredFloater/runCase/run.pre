#!/bin/sh

SOURCE_DIR1="../components/flume/constant/polyMesh"
TARGET_DIR1="constant/out/polyMesh"

rm -rf "$TARGET_DIR1"
cp -r "$SOURCE_DIR1" "$TARGET_DIR1"

echo "polyMesh copied from $SOURCE_DIR1 to $TARGET_DIR1"

SOURCE_DIR2="../components/floaterInside/constant/polyMesh"
TARGET_DIR2="constant/in/polyMesh"

rm -rf "$TARGET_DIR2"
cp -r "$SOURCE_DIR2" "$TARGET_DIR2"

echo "polyMesh copied from $SOURCE_DIR2 to $TARGET_DIR2"


rm -fr 0
cp -r 0.org 0

setFields -region out
setFields -region in
